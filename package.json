{
  "name": "shotcount",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:ui": "VITE_AGENT_E2E=true pnpm build && node scripts/agent-ui.e2e.mjs",
    "test:flight:live": "SHOTCOUNT_LIVE_FLIGHT_TEST=true vitest run api/_flight-browser.live.test.ts",
    "benchmark:agent": "vitest run benchmarks/agent-execution/run-benchmark.test.ts && node benchmarks/agent-execution/generate-report.mjs",
    "benchmark:agent:live": "node benchmarks/agent-execution-live/run-live.mjs",
    "check": "pnpm test && pnpm build",
    "check:cloud": "node scripts/verify-cloud.mjs",
    "check:cloud:auth": "node scripts/verify-cloud-auth.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.110.0",
    "playwright-core": "^1.61.1"
  }
}
