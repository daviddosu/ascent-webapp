VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key

# Supabase Edge Function secrets. Never prefix these with VITE_.
OPENAI_API_KEY=replace-with-a-new-server-side-key
SHOTCOUNT_APP_ORIGINS=https://app.shotcount.app,http://127.0.0.1:5173
SHOTCOUNT_BROWSER_ALLOWED_DOMAINS=www.google.com,app.shotcount.app
SHOTCOUNT_BROWSER_WORKER_URL=https://app.shotcount.app/api/browser-worker
SHOTCOUNT_BROWSER_WORKER_TOKEN=replace-with-a-long-random-server-secret
SHOTCOUNT_INTERNAL_WORKER_TOKEN=replace-with-a-separate-long-random-server-secret
SHOTCOUNT_CRON_TOKEN=replace-with-a-third-long-random-server-secret
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/google-oauth-callback
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Development only. Never enable this in production.
SHOTCOUNT_ENABLE_DEMO_REPLY_SIMULATION=false

# Vercel browser worker. These are server-only and must never use VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
# It also receives the exact SHOTCOUNT_BROWSER_WORKER_TOKEN declared above.
# Optional for local worker verification on macOS/Linux.
CHROME_EXECUTABLE_PATH=

# Optional verification-only account. Never use a real person's account.
SHOTCOUNT_TEST_EMAIL=shotcount-verification@example.com
SHOTCOUNT_TEST_PASSWORD=replace-with-a-test-password
SHOTCOUNT_TEST_AI=false
